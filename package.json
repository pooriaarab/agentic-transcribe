{
  "name": "agentic-transcribe",
  "version": "0.1.0",
  "description": "Transcribe one audio file with timestamps.",
  "keywords": ["transcription", "audio", "cli", "mcp", "openai", "deepgram", "assemblyai"],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": { "type": "git", "url": "https://github.com/pooriaarab/agentic-transcribe.git" },
  "type": "module",
  "engines": { "node": ">=18" },
  "files": ["dist"],
  "publishConfig": { "access": "public" },
  "mcpName": "io.github.pooriaarab/agentic-transcribe",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "bin": { "agentic-transcribe": "./dist/cli.js", "agentic-transcribe-mcp": "./dist/mcp-bin.js" },
  "scripts": { "build": "tsup", "typecheck": "tsc --noEmit", "test": "vitest run", "clean": "rm -rf dist" },
  "dependencies": { "@modelcontextprotocol/sdk": "^1.12.0", "zod": "^3.25.0" },
  "devDependencies": { "@types/node": "^22.0.0", "tsup": "^8.0.0", "typescript": "^5.6.0", "vitest": "^3.0.0" }
